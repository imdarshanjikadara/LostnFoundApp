# =============================================================================
# Git Ignore Configuration
# =============================================================================

# Environment Variables & Secrets (CRITICAL: NEVER COMMIT SECRETS TO GITHUB)
.env
.env.local
.env.*.local
.env.*
*.env
!.env.example

# Dependencies & Package Managers
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Vercel deployment cache
.vercel/

# Antigravity IDE / Agent scratch files
.agents/
.gemini/
.system_generated/
*.log

# OS generated files
.DS_Store
Thumbs.db
desktop.ini
